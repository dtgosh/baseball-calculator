		text-align: right;
	}
	.in:focus {
		border-color: oklch(0.5 0.13 255);
		outline: none;
		background: #ffffff;
	}
	.bench-in {
		color: #4a515c;
	}

	.calc-row {
		flex: 1 1 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 14px;
		margin: 4px 0;
	}
	.calc-btn {
		background: #1b1f27;
		color: #ffffff;
		border: none;
		border-radius: 8px;
		padding: 11px 30px;
		font-size: 14px;
		font-weight: 600;
		letter-spacing: 0.02em;
		cursor: pointer;
	}
	.calc-btn:hover {
		background: #333a45;
	}
	.dirty-note {
		font-size: 12px;
		color: oklch(0.5 0.13 40);
		font-weight: 500;
	}

	.result-section {
		padding: 24px 20px;
	}
	.result-inner {
		max-width: 760px;
		margin: 0 auto;
	}

	.pct-row {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 12px;
		margin-top: 18px;
	}
	.pct-block {
		min-width: 0;
	}
	.pct-name {
		font-size: 13px;
		font-weight: 700;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.muted-label {
		font-weight: 500;
		color: #8a919d;
	}
	.pct-num {
		font-family: 'IBM Plex Mono', monospace;
		font-size: clamp(32px, 4.5vw, 44px);
		font-weight: 600;
		line-height: 1.1;
	}
	.pct-sign {
		font-size: 18px;
		color: #626a76;
	}
	.pct-caption {
		font-size: 11px;
		color: #8a919d;
		padding-bottom: 10px;
		white-space: nowrap;
	}

	.away-color {
		color: oklch(0.5 0.13 40);
	}
	.home-color {
		color: oklch(0.5 0.13 255);
	}

	.prob-bar-wrap {
		position: relative;
		margin-top: 12px;
	}
	.prob-bar {
		display: flex;
		height: 10px;
		border-radius: 5px;
		overflow: hidden;
		background: #eceef1;
	}
	.prob-away {
		width: 50%;
		background: oklch(0.5 0.13 40);
	}
