		font-weight: 700;
		color: #626a76;
		margin-bottom: 10px;
	}
	.factors-list {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.factor-row {
		display: grid;
		grid-template-columns: 110px 1fr auto;
		align-items: baseline;
		gap: 10px;
		font-size: 12.5px;
	}
	.factor-label {
		color: #1b1f27;
		font-weight: 500;
	}
	.factor-detail {
		color: #8a919d;
		font-family: 'IBM Plex Mono', monospace;
		font-size: 11.5px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.factor-imp {
		font-family: 'IBM Plex Mono', monospace;
		font-size: 12.5px;
		font-weight: 600;
		white-space: nowrap;
	}

	.footer {
		margin-top: 12px;
		font-size: 11px;
		color: #a3a9b3;
