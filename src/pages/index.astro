</style>

<script>
	import {
		L,
		TEAMS,
		HOME_ADV,
		ERA_WEIGHT,
		ACCENT,
		num,
		clamp,
		wStat,
		battingAvg,
		battingOps,
		pitchingEra,
		pitchingWhip,
		pitchingK9,
	} from '../data/kbo';

	const C_AWAY = ACCENT.away;
	const C_HOME = ACCENT.home;

	const logit = (p: number) => Math.log(p / (1 - p));
	const sig = (x: number) => 1 / (1 + Math.exp(-x));
	const f3 = (x: number) => x.toFixed(3);

	let hasGameRes = false;
	let gameDirty = false;

	const dirtyNote = document.getElementById('dirty-note') as HTMLElement;
	const resultSection = document.getElementById('result-section') as HTMLElement;

	function updateDirtyNote() {
		dirtyNote.style.display = hasGameRes && gameDirty ? '' : 'none';
	}

	function setDirty() {
		gameDirty = true;
		updateDirtyNote();
	}

	function readBatRaw(side: string): { [k: string]: string }[] {
		const rows: { [k: string]: string }[] = [];
		document
			.querySelectorAll<HTMLInputElement>(`input[data-side="${side}"][data-group="bat"]`)
			.forEach((el) => {
				const i = Number(el.dataset.index);
				const field = el.dataset.field as string;
				if (field === 'name') return;
				if (!rows[i]) rows[i] = {};
				rows[i][field] = el.value;
			});
		return rows;
	}

	function updateLineupOps(side: string) {
		const rows = readBatRaw(side);
		const val = wStat(rows, (b) => battingOps(b, L.ops), L.ops, 0.2, 1.5);
		const label = document.getElementById(`ops-${side}`);
		if (label) label.textContent = `OPS ${val.toFixed(3)}`;
	}

	document.querySelectorAll<HTMLInputElement>('input[data-group="bat"]').forEach((input) => {
		const field = input.dataset.field;
		input.addEventListener('input', () => {
			if (field === 'name') return; // cosmetic only, never dirty
			setDirty();
			updateLineupOps(input.dataset.side as string);
		});
	});

	document.querySelectorAll<HTMLInputElement>('input[data-group="bench"]').forEach((input) => {
		// intentionally no dirty-flag / recompute wiring — bench stats are not read by computeGame()
		input.addEventListener('input', () => {});
	});

	document.querySelectorAll<HTMLInputElement>('input[data-group="arms"]').forEach((input) => {
		const field = input.dataset.field;
		input.addEventListener('input', () => {
			if (field === 'name') return;
			setDirty();
		});
	});

	document.querySelectorAll<HTMLSelectElement>('select[data-field="team"]').forEach((select) => {
		select.addEventListener('change', () => {
			setDirty();
		});
	});

	function readSide(side: string) {
		const batRows = readBatRaw(side);

		const armRows: { [k: string]: string }[] = [];
		document
			.querySelectorAll<HTMLInputElement>(`input[data-side="${side}"][data-group="arms"]`)
			.forEach((el) => {
				const i = Number(el.dataset.index);
				const field = el.dataset.field as string;
				if (field === 'name') return;
				if (!armRows[i]) armRows[i] = {};
				armRows[i][field] = el.value;
			});

		const teamSelect = document.querySelector<HTMLSelectElement>(
			`select[data-side="${side}"][data-field="team"]`
		);
		const teamIdx = teamSelect ? Number(teamSelect.value) : 0;

		const armAt = (i: number) => ({
			era: clamp(pitchingEra(armRows[i], L.era), 0.5, 12),
			whip: clamp(pitchingWhip(armRows[i], L.whip), 0.6, 2.5),
			k9: clamp(pitchingK9(armRows[i], L.k9), 2, 15),
		});
		const sp = armAt(0);
		const bp = { era: 0, whip: 0, k9: 0 };
		for (let i = 1; i < 5; i++) {
			const a = armAt(i);
			bp.era += a.era / 4;
			bp.whip += a.whip / 4;
			bp.k9 += a.k9 / 4;
		}
		let sb = 0;
		batRows.forEach((b) => {
			sb += clamp(num(b.sb, 0), 0, 150);
		});
		return {
			sp,
			bp,
			eraComb: 0.65 * sp.era + 0.35 * bp.era,
			ops: wStat(batRows, (b) => battingOps(b, L.ops), L.ops, 0.2, 1.5),
			avg: wStat(batRows, (b) => battingAvg(b, L.avg), L.avg, 0.15, 0.45),
			sb,
			name: TEAMS[teamIdx] || TEAMS[0],
		};
	}

	function computeGame() {
		const homeAdv = HOME_ADV;
		const eraW = ERA_WEIGHT;
		const A = readSide('away');
		const H = readSide('home');

		const cSp =
			((A.sp.era - H.sp.era) * 0.14 + (A.sp.whip - H.sp.whip) * 0.45 + (H.sp.k9 - A.sp.k9) * 0.025) * eraW;
		const cBp =
			((A.bp.era - H.bp.era) * 0.07 + (A.bp.whip - H.bp.whip) * 0.22 + (H.bp.k9 - A.bp.k9) * 0.012) * eraW;
		const cBat = (H.ops - A.ops) * 2.8 + (H.avg - A.avg) * 0.9;
		const cRun = clamp((H.sb - A.sb) * 0.002, -0.2, 0.2);
		const cHome = logit(clamp(0.5 + homeAdv, 0.5, 0.6));
		const pHome = sig(cSp + cBp + cBat + cRun + cHome);

		const xr = (t: typeof A, o: typeof A, home: boolean) =>
			clamp(L.rpg * Math.pow(t.ops / L.ops, 1.8) * Math.pow(o.eraComb / L.era, 0.9) * (home ? 1.04 : 1.0), 0.5, 15);
		const xA = xr(A, H, false);
		const xH = xr(H, A, true);
		let sA = Math.round(xA);
		let sH = Math.round(xH);
		if (sA === sH) {
			if (pHome >= 0.5) sH += 1;
			else sA += 1;
		}

		return {
			awayName: A.name,
			homeName: H.name,
			pHome,
			sA,
			sH,
			factors: [
				{
					label: '선발 매치업',
					detail:
						'ERA ' +
						A.sp.era.toFixed(2) +
						'/' +
						H.sp.era.toFixed(2) +
						' · WHIP ' +
						A.sp.whip.toFixed(2) +
						'/' +
						H.sp.whip.toFixed(2) +
						' · K/9 ' +
						A.sp.k9.toFixed(1) +
						'/' +
						H.sp.k9.toFixed(1),
					c: cSp,
				},
				{
					label: '불펜·마무리',
					detail:
						'ERA ' +
						A.bp.era.toFixed(2) +
						'/' +
						H.bp.era.toFixed(2) +
						' · WHIP ' +
						A.bp.whip.toFixed(2) +
						'/' +
						H.bp.whip.toFixed(2),
					c: cBp,
				},
				{
					label: '라인업 타격',
					detail: 'OPS ' + f3(A.ops) + '/' + f3(H.ops) + ' · AVG ' + f3(A.avg) + '/' + f3(H.avg),
					c: cBat,
				},
				{ label: '주루', detail: '라인업 도루 ' + A.sb + '/' + H.sb, c: cRun },
				{ label: '홈 어드밴티지', detail: '설정 +' + (homeAdv * 100).toFixed(1) + '%p', c: cHome },
			],
		};
	}

	function renderResult(G: ReturnType<typeof computeGame>) {
		const awayPct = ((1 - G.pHome) * 100).toFixed(1);
		const homePct = (G.pHome * 100).toFixed(1);

		document.getElementById('away-name-text')!.textContent = G.awayName;
		document.getElementById('home-name-text')!.textContent = G.homeName;
		document.getElementById('away-pct')!.textContent = awayPct;
		document.getElementById('home-pct')!.textContent = homePct;
		(document.getElementById('prob-away-bar') as HTMLElement).style.width = `${awayPct}%`;
		document.getElementById('away-score')!.textContent = String(G.sA);
		document.getElementById('home-score')!.textContent = String(G.sH);

		G.factors.forEach((f, i) => {
			const pp = (sig(f.c) - 0.5) * 100;
			const neutral = Math.abs(pp) < 0.05;
			const impText = neutral ? '±0.0%p' : (pp > 0 ? '홈 +' : '원정 +') + Math.abs(pp).toFixed(1) + '%p';
			const color = neutral ? '#8a919d' : pp > 0 ? C_HOME : C_AWAY;
			const detailEl = document.getElementById(`factor-detail-${i}`)!;
			const impEl = document.getElementById(`factor-imp-${i}`) as HTMLElement;
			detailEl.textContent = f.detail;
			impEl.textContent = impText;
			impEl.style.color = color;
		});

		resultSection.style.display = 'block';
	}

	document.getElementById('calc-btn')!.addEventListener('click', () => {
		const G = computeGame();
		renderResult(G);
		hasGameRes = true;
		gameDirty = false;
		updateDirtyNote();
	});
</script>
