		gap: 4px;
		min-width: 378px;
	}
	.ta-right {
		text-align: right;
	}

	.row-list {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}
	.row {
		display: grid;
		align-items: center;
		padding: 0 8px;
	}
	.row-no {
		font-family: 'IBM Plex Mono', monospace;
		font-size: 11.5px;
		color: #8a919d;
	}
	.row-role {
		font-family: 'IBM Plex Mono', monospace;
		font-size: 11px;
		color: #8a919d;
	}
	.bench-no {
		color: #b6bcc5;
	}

	.in {
		width: 100%;
		box-sizing: border-box;
		padding: 3px 7px;
		border: 1px solid #e2e5ea;
