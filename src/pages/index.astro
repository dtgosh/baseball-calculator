---
import Layout from '../layouts/Layout.astro';
import RosterCard from '../components/RosterCard.astro';
import { L, ACCENT, initRoster, wStat, battingOps } from '../data/kbo';

const roster = initRoster();
const sel = { away: '1', home: '0' };

const sides = (['away', 'home'] as const).map((side) => ({
	side,
	roleLabel: side === 'away' ? '원정' : '홈',
	accent: ACCENT[side],
	teamIdx: sel[side],
	lineupOps: wStat(roster[side].bat, (b) => battingOps(b, L.ops), L.ops, 0.2, 1.5).toFixed(3),
	batters: roster[side].bat,
	arms: roster[side].arms,
	bench: roster[side].bench,
}));
---

<Layout title="야구 계산기">
	<div class="page">
		<div class="page-inner">
			<header class="header">
				<h1 class="title">야구 계산기</h1>
			</header>

			<main class="main">
				<section class="card">
					<h2 class="card-title">라인업 입력</h2>
					<div class="roster-grid">
						{sides.map((r) => <RosterCard {...r} />)}
					</div>
				</section>

				<div class="calc-row">
					<button id="calc-btn" class="calc-btn" type="button">계산하기</button>
					<span id="dirty-note" class="dirty-note" style="display: none;">
						입력이 변경되었습니다 · 다시 계산하세요
					</span>
				</div>

				<section id="result-section" class="card result-section" style="display: none;">
					<div class="result-inner">
						<h2 class="card-title">계산 결과</h2>

						<div class="pct-row">
							<div class="pct-block">
								<div class="pct-name away-color">
									<span id="away-name-text"></span> <span class="muted-label">원정</span>
								</div>
								<div class="pct-num"><span id="away-pct"></span><span class="pct-sign">%</span></div>
							</div>
							<div class="pct-caption">승리 확률</div>
							<div class="pct-block ta-right">
								<div class="pct-name home-color">
									<span class="muted-label">홈</span> <span id="home-name-text"></span>
								</div>
								<div class="pct-num"><span id="home-pct"></span><span class="pct-sign">%</span></div>
							</div>
						</div>

						<div class="prob-bar-wrap">
							<div class="prob-bar">
								<div id="prob-away-bar" class="prob-away"></div>
								<div class="prob-home"></div>
							</div>
							<div class="prob-tick"></div>
						</div>

						<div class="score-box">
							<div class="score-label">예상 스코어</div>
							<div class="score-num">
								<span id="away-score" class="away-color"></span><span class="score-colon">:</span><span
									id="home-score"
									class="home-color"></span>
							</div>
						</div>

						<div class="factors">
							<div class="factors-title">요인 분해</div>
							<div class="factors-list">
								<div class="factor-row">
									<span class="factor-label">선발 매치업</span>
									<span id="factor-detail-0" class="factor-detail"></span>
									<span id="factor-imp-0" class="factor-imp"></span>
								</div>
								<div class="factor-row">
									<span class="factor-label">불펜·마무리</span>
									<span id="factor-detail-1" class="factor-detail"></span>
									<span id="factor-imp-1" class="factor-imp"></span>
								</div>
								<div class="factor-row">
									<span class="factor-label">라인업 타격</span>
									<span id="factor-detail-2" class="factor-detail"></span>
									<span id="factor-imp-2" class="factor-imp"></span>
								</div>
								<div class="factor-row">
									<span class="factor-label">주루</span>
									<span id="factor-detail-3" class="factor-detail"></span>
									<span id="factor-imp-3" class="factor-imp"></span>
								</div>
								<div class="factor-row">
									<span class="factor-label">홈 어드밴티지</span>
									<span id="factor-detail-4" class="factor-detail"></span>
									<span id="factor-imp-4" class="factor-imp"></span>
								</div>
							</div>
						</div>
					</div>
				</section>
			</main>

			<footer class="footer">© 2026 dtgosh. All rights reserved.</footer>
		</div>
	</div>
</Layout>

<style>
	.page {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 0 20px 16px 20px;
		box-sizing: border-box;
	}
	.page-inner {
		width: 100%;
		max-width: 1180px;
	}

	.header {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 16px;
		padding: 14px 0 10px 0;
		border-bottom: 2px solid #1b1f27;
	}
	.title {
		margin: 0;
		font-size: clamp(20px, 3vw, 28px);
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.main {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 12px;
	}

	.card {
		flex: 1 1 100%;
		background: #ffffff;
		border: 1px solid #e2e5ea;
		border-radius: 12px;
		padding: 14px;
		box-sizing: border-box;
	}
	.card-title {
		margin: 0 0 8px 0;
		font-size: 14px;
		font-weight: 700;
	}

	.roster-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	.roster-side {
		flex: 1 1 480px;
		min-width: 0;
		border: 1px solid #e8eaef;
		border-radius: 10px;
		padding: 10px;
		box-sizing: border-box;
	}
	.roster-side-head {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 8px;
	}
	.chip {
		font-size: 11px;
		font-weight: 700;
		color: #ffffff;
		border-radius: 5px;
		padding: 3px 8px;
		letter-spacing: 0.04em;
		flex-shrink: 0;
	}
	.team-select {
		flex: 1;
		min-width: 0;
		padding: 6px 8px;
		border: 1px solid #d4d8df;
		border-radius: 7px;
		background: #fbfbfc;
		font-size: 13px;
		font-weight: 500;
